---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL;
---

<StarlightPage frontmatter={{ title: "CLIver" }}>
  <div class="hero" style="padding:4rem 2rem;margin-bottom:3rem;text-align:center;">
    <img
      src={`${base}icon.png`}
      alt="CLIver"
      style="width:96px;height:96px;margin:0 auto 1.5rem;display:block;"
    />
    <h1 style="font-size:3rem;font-weight:800;margin:0 0 1rem;">
      <span class="hero-gradient-text">CLIver</span>
    </h1>
    <p style="font-size:1.25rem;color:var(--sl-color-gray-2);max-width:600px;margin:0 auto 2rem;line-height:1.6;">
      A Personal AI Lab — an embeddable Python agent engine,
      with a CLI application in progress.
    </p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a
        href={`${base}getting-started/`}
        style="background:var(--hero-gradient);color:#fff;padding:0.75rem 1.5rem;border-radius:0.5rem;font-weight:600;text-decoration:none;transition:opacity 0.2s;"
      >
        Get Started
      </a>
      <a
        href={`${base}core-concepts/`}
        style="background:var(--sl-color-gray-7);color:var(--sl-color-white);padding:0.75rem 1.5rem;border-radius:0.5rem;font-weight:600;text-decoration:none;border:1px solid var(--sl-color-hairline);transition:border-color 0.2s;"
      >
        Learn More
      </a>
    </div>
  </div>

  <h2 style="text-align:center;margin-bottom:2rem;">What CLIver Can Do</h2>

  <div class="feature-grid" style="margin-bottom:4rem;">
    <div class="feature-card">
      <div class="feature-icon">🔌</div>
      <h3>Model-Agnostic</h3>
      <p>
        Connect to any OpenAI-compatible API, Anthropic-protocol endpoints, or
        local models via Ollama. Switch providers on the fly — no vendor lock-in.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🧠</div>
      <h3>AgentCore Engine</h3>
      <p>
        A clean Re-Act loop with <code>chat()</code> and <code>stream()</code> APIs.
        Supports text, image, audio, and video generation when configured. Embed into your own Python applications.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🛠️</div>
      <h3>Built-in Tools</h3>
      <p>
        Nine tools for file I/O, shell execution, code, web fetching, and todo
        tracking — all sharing one permission and event pipeline.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🎯</div>
      <h3>Skills System</h3>
      <p>
        LLM-driven skill activation following the <a href="https://agentskills.io/specification" style="color:inherit;">Agent Skills specification</a>.
        Built-in skills for brainstorming, planning, and structured execution.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">🔐</div>
      <h3>Opt-in Policy</h3>
      <p>
        SAFE/ASK permission gates with an application-supplied callback, plus
        execution scopes for environment, working directory, and paths.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">⚡</div>
      <h3>MCP Support</h3>
      <p>
        Connect stdio and streamable HTTP servers. MCP tools share the same
        execution path as builtin tools; prompts and resources are read on demand.
      </p>
    </div>
  </div>

  <div style="background:var(--sl-color-gray-7);border:1px solid var(--sl-color-hairline);border-radius:0.75rem;padding:2rem;margin-bottom:2rem;">
    <h2 style="margin-top:0;">Quick Start</h2>
    <p style="color:var(--sl-color-gray-3);margin-bottom:1.5rem;">Install the core library and run your first agent.</p>

    <pre style="background:var(--sl-color-black);padding:1.5rem;border-radius:0.5rem;overflow-x:auto;"><code>pip install cliver-core==0.3.0a5

python - &lt;&lt;'PY'
import asyncio
from cliver_core import AgentCore, ModelBindings, presets

agent = AgentCore(ModelBindings(llm=presets.deepseek()))
print(asyncio.run(agent.chat("Hello!")).message.content)
PY</code></pre>
  </div>
</StarlightPage>
