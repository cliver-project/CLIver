---
import Search from "@astrojs/starlight/components/Search.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === base ? path === base : path.startsWith(href);

const navItems = [
  {
    label: "Getting Started",
    href: `${base}getting-started/`,
    children: [
      { label: "Introduction", href: `${base}getting-started/` },
      { label: "Installation", href: `${base}getting-started/installation/` },
      { label: "Stability & Versioning", href: `${base}getting-started/stability/` },
    ],
  },
  {
    label: "Core Concepts",
    href: `${base}core-concepts/`,
    children: [
      { label: "AgentCore", href: `${base}core-concepts/` },
      { label: "Tools", href: `${base}core-concepts/tools/` },
      { label: "Skills", href: `${base}core-concepts/skills/` },
      { label: "MCP", href: `${base}core-concepts/mcp/` },
      { label: "Permissions & Policy", href: `${base}core-concepts/policy/` },
      { label: "Media Capabilities", href: `${base}core-concepts/media/` },
    ],
  },
  {
    label: "Models",
    href: `${base}configuration/`,
    children: [
      { label: "Model Bindings", href: `${base}configuration/` },
      { label: "Providers & Presets", href: `${base}configuration/providers/` },
    ],
  },
  {
    label: "CLI Application",
    href: `${base}cli/`,
    children: [{ label: "Overview", href: `${base}cli/` }],
  },
  {
    label: "API",
    href: `${base}api/`,
  },
  {
    label: "Blog",
    href: `${base}blog/`,
  },
];
---

<header class="header">
  <div class="header__inner">
    <div class="header__left">
      <a href={base} class="site-logo">
        <img src={`${base}icon.png`} alt="CLIver" width="28" height="28" />
        <span class="brand-name">CLIver</span>
      </a>
      <nav class="header__nav" aria-label="Main">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="nav-dropdown">
                <a
                  href={item.href}
                  class="nav-dropdown__trigger"
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
                <div class="nav-dropdown__menu">
                  {item.children.map((child) => (
                    <a href={child.href}>{child.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ),
          )
        }
      </nav>
    </div>
    <div class="header__right">
      <a href={`${base}blog/rss.xml`} class="gh-link" aria-label="RSS feed" title="RSS feed">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="6.5" cy="17.5" r="2.2" fill="currentColor" />
          <path d="M4 4.5a15.5 15.5 0 0 1 15.5 15.5M4 10a10 10 0 0 1 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </a>
      <a
        href="https://github.com/cliver-project/CLIver"
        class="gh-link"
        target="_blank"
        rel="noopener"
        aria-label="GitHub repository"
        title="GitHub repository"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <Search />
      <ThemeSelect />
      <details class="mobile-nav">
        <summary aria-label="Open navigation">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M3 7h18M3 12h18M3 17h18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="mobile-nav__panel">
          {
            navItems.map((item) => (
              <div class="mobile-nav__group">
                <a class="mobile-nav__label" href={item.href}>
                  {item.label}
                </a>
                {item.children?.map((child) => (
                  <a class="mobile-nav__child" href={child.href}>
                    {child.label}
                  </a>
                ))}
              </div>
            ))
          }
          <div class="mobile-nav__links">
            <a href="https://github.com/cliver-project/CLIver" target="_blank" rel="noopener">GitHub</a>
            <a href="https://pypi.org/project/cliver-core/" target="_blank" rel="noopener">PyPI</a>
            <a href={`${base}blog/rss.xml`}>RSS</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--sl-nav-height, 3.75rem);
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--fv-border);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 90rem;
    margin: 0 auto;
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    min-width: 0;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .site-logo img {
    border-radius: 0.35rem;
  }

  .brand-name {
    font-family: var(--fv-serif);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .header__nav {
    display: flex;
    gap: 0.15rem;
    align-items: center;
  }

  .header__nav > a,
  .nav-dropdown__trigger {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.42rem 0.62rem;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: 0.845rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }

  .header__nav > a:hover,
  .nav-dropdown__trigger:hover,
  .nav-dropdown:focus-within .nav-dropdown__trigger {
    color: var(--sl-color-white);
    background: var(--fv-surface);
  }

  .header__nav > a[aria-current="page"],
  .nav-dropdown__trigger[aria-current="page"] {
    color: var(--sl-color-white);
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.6rem;
  }

  .nav-dropdown__trigger::after {
    content: "";
    display: inline-block;
    width: 0.38rem;
    height: 0.38rem;
    margin-top: -2px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    opacity: 0.45;
    transform: rotate(45deg);
  }

  .nav-dropdown__menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 210px;
    margin-top: 0.45rem;
    padding: 0.45rem;
    border: 1px solid var(--fv-border);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 94%, transparent);
    box-shadow: var(--fv-shadow);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav-dropdown:hover .nav-dropdown__menu,
  .nav-dropdown:focus-within .nav-dropdown__menu {
    display: block;
  }

  .nav-dropdown__menu a {
    display: block;
    padding: 0.42rem 0.65rem;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }

  .nav-dropdown__menu a:hover {
    color: var(--sl-color-white);
    background: var(--fv-signal-soft);
  }

  .header__right {
    display: flex;
    flex-shrink: 0;
    gap: 0.2rem;
    align-items: center;
  }

  .gh-link {
    display: flex;
    align-items: center;
    padding: 0.42rem;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    transition: color 0.15s, background 0.15s;
  }

  .gh-link:hover {
    color: var(--sl-color-white);
    background: var(--fv-surface);
  }

  /* Mobile navigation */
  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav summary {
    display: flex;
    align-items: center;
    padding: 0.42rem;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary:hover {
    color: var(--sl-color-white);
    background: var(--fv-surface);
  }

  .mobile-nav__panel {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    width: min(19rem, calc(100vw - 2rem));
    max-height: calc(100vh - 5rem);
    overflow-y: auto;
    padding: 0.8rem;
    border: 1px solid var(--fv-border);
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--fv-shadow);
  }

  .mobile-nav__group {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--fv-border);
  }

  .mobile-nav__label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--sl-color-white);
    font-family: var(--fv-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-nav__child {
    display: block;
    padding: 0.32rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .mobile-nav__child:hover {
    color: var(--sl-color-white);
    background: var(--fv-surface);
  }

  .mobile-nav__links {
    display: flex;
    gap: 1rem;
    padding: 0.8rem 0.5rem 0.25rem;
    font-size: 0.82rem;
  }

  .mobile-nav__links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .mobile-nav__links a:hover {
    color: var(--fv-signal);
  }

  @media (max-width: 1024px) {
    .header__nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  /* Below 50rem Starlight opens the full docs sidebar as a drawer, so the
     header dropdown would be a second menu for the same pages. */
  @media (max-width: 49.99rem) {
    :global(html[data-has-sidebar]) .mobile-nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header {
      padding: 0 1rem;
    }

    .header__right > :global(.gh-link) {
      display: none;
    }
  }
</style>
